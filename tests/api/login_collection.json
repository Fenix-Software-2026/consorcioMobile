{
  "info": {
    "name": "ConsorcioMobile - Auth API Tests",
    "_postman_id": "auth-consorcio-tc-login",
    "description": "Pruebas de API contra endpoint de autenticacion /api/login/",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://gaston.alwaysdata.net"
    }
  ],
  "item": [
    {
      "name": "TC-L-07 - Login Credenciales Validas (200 OK)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"residentePrueba1\",\n    \"password\": \"Contraseña\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-L-07: Status code es 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('TC-L-07: Header Content-Type es application/json', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test('TC-L-07: Tiempo de respuesta menor a 800 ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(800);",
              "});",
              "",
              "pm.test('TC-L-07: Contrato valido (devuelve access token de tipo string)', function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('access');",
              "    pm.expect(data.access).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-L-02 - Login Credenciales Invalidas (401 Unauthorized)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"juan\",\n    \"password\": \"abdcefghijk\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-L-02: Status code es 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('TC-L-02: Tiempo de respuesta menor a 800 ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(800);",
              "});",
              "",
              "pm.test('TC-L-02: Mensaje de error de credenciales presente en respuesta', function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('detail');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}