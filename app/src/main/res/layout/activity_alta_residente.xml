<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <include
        android:id="@+id/usuariosToolbar"
        layout="@layout/barra_personalizada" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuevo inquilino"
                android:textColor="@color/texto_principal"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:text="Completa los datos para registrar un nuevo residente."
                android:textColor="@color/gris_texto"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/blanco"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATOS DEL INQUILINO"
                        android:textColor="@color/gris_texto"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etUsuarioInquilino"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/gris_fondo_input"
                        android:hint="Usuario *"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etNombreInquilino"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/gris_fondo_input"
                        android:hint="Nombre *"
                        android:inputType="textPersonName|textCapSentences"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etApellidoInquilino"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/gris_fondo_input"
                        android:hint="Apellido *"
                        android:inputType="textPersonName|textCapSentences"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etEmailInquilino"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/gris_fondo_input"
                        android:hint="Email *"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Unidad funcional *"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spUnidadFuncional"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/gris_fondo_input"
                        android:paddingHorizontal="8dp"
                        android:prompt="@string/seleccionar_unidad"
                        android:spinnerMode="dropdown" />

                    <Button
                        android:id="@+id/btnCrearInquilino"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/naranja"
                        android:text="Crear inquilino"
                        android:textColor="@color/blanco"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>