<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Barra superior institucional con color naranja moderno -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/naranja"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ConsorcioMobile - Panel Admin"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Botón para salir del panel, con el mismo estilo que el del residente -->
        <Button
            android:id="@+id/btnVolverComunicados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Volver"
            android:textSize="12sp"
            android:textColor="@color/naranja"
            android:backgroundTint="@color/white"
            app:cornerRadius="20dp"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

    <!-- Contenedor con el formulario y la sección de historial -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Título de la Sección -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_crear_comunicado"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/negro"
            android:layout_marginBottom="16dp"/>

        <!-- Tarjeta del formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="24dp">

            <!-- Campo Título -->
            <EditText
                android:id="@+id/etTituloComunicado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_titulo_comunicado"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:background="@color/gris_fondo_input"
                android:textColor="@color/negro"
                android:layout_marginBottom="12dp"/>

            <!-- Campo Cuerpo -->
            <EditText
                android:id="@+id/etCuerpoComunicado"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="@string/hint_cuerpo_comunicado"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:padding="12dp"
                android:background="@color/gris_fondo_input"
                android:textColor="@color/negro"
                android:layout_marginBottom="12dp"/>

            <!-- Checkbox para marcar como Urgente -->
            <CheckBox
                android:id="@+id/cbUrgente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Urgente (resaltará en la lista)"
                android:textColor="@color/naranja"
                android:textStyle="bold"
                android:buttonTint="@color/naranja"
                android:layout_marginBottom="16dp"/>

            <!-- Botón Publicar -->
            <Button
                android:id="@+id/btnPublicar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_publicar_comunicado"
                android:backgroundTint="@color/naranja"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:minHeight="48dp"/>

            <!-- Aparece solo cuando estamos editando un comunicado existente -->
            <Button
                android:id="@+id/btnCancelarEdicion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Cancelar edición"
                android:backgroundTint="@color/negro"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:minHeight="48dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Historial de Comunicados -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Historial de Comunicados"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/negro"
            android:layout_marginBottom="12dp"/>

        <!-- Mensaje cuando todavía no hay comunicados -->
        <TextView
            android:id="@+id/tvSinComunicadosAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Todavía no hay comunicados publicados."
            android:textSize="14sp"
            android:textColor="#777777"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:visibility="gone" />

        <!-- Lista con los comunicados que vienen de la API -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerComunicadosAdmin"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
