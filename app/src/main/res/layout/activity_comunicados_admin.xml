<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Barra superior institucional con color naranja moderno -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/naranja"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ConsorcioMobile - Panel Admin"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenedor con scroll para organizar el formulario y la sección de historial -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Título de la Sección -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_crear_comunicado"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/negro"
                android:layout_marginBottom="16dp"/>

            <!-- Tarjeta del formulario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="24dp">

                <!-- Campo Título -->
                <EditText
                    android:id="@+id/etTituloComunicado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_titulo_comunicado"
                    android:inputType="textPersonName"
                    android:minHeight="48dp"
                    android:paddingHorizontal="12dp"
                    android:background="@color/gris_fondo_input"
                    android:textColor="@color/negro"
                    android:layout_marginBottom="12dp"/>

                <!-- Campo Cuerpo -->
                <EditText
                    android:id="@+id/etCuerpoComunicado"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:hint="@string/hint_cuerpo_comunicado"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:padding="12dp"
                    android:background="@color/gris_fondo_input"
                    android:textColor="@color/negro"
                    android:layout_marginBottom="12dp"/>

                <!-- Checkbox para marcar como Urgente -->
                <CheckBox
                    android:id="@+id/cbUrgente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urgente (resaltará en la lista)"
                    android:textColor="@color/naranja"
                    android:textStyle="bold"
                    android:buttonTint="@color/naranja"
                    android:layout_marginBottom="16dp"/>

                <!-- Botón Publicar -->
                <Button
                    android:id="@+id/btnPublicar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_publicar_comunicado"
                    android:backgroundTint="@color/naranja"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:minHeight="48dp"/>
            </LinearLayout>

            <!-- Historial de Comunicados -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Historial de Comunicados"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/negro"
                android:layout_marginBottom="12dp"/>

            <!-- Ejemplo 1: Comunicado URGENTE (Resaltado con naranjaclaro y botón borrar) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/naranjaclaro"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="[URGENTE] Corte de Gas"
                        android:textStyle="bold"
                        android:textColor="@color/negro"
                        android:textSize="14sp"/>

                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:text="Borrar"
                        android:textSize="12sp"
                        android:backgroundTint="@color/rojo"
                        android:textColor="@color/white"
                        android:paddingHorizontal="12dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Corte total por una hora debido a mantenimiento..."
                    android:textColor="@color/negro"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Publicado: 13/09/2026"
                    android:textColor="@color/negro"
                    android:textSize="10sp"
                    android:textStyle="italic"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- Ejemplo 2: Comunicado Normal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/gris_fondo_input"
                android:padding="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Reunión Anual de Consorcio"
                        android:textStyle="bold"
                        android:textColor="@color/negro"
                        android:textSize="14sp"/>

                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:text="Borrar"
                        android:textSize="12sp"
                        android:backgroundTint="@color/negro"
                        android:textColor="@color/white"
                        android:paddingHorizontal="12dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Se convoca a todos los propietarios..."
                    android:textColor="@color/negro"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Publicado: 10/09/2026"
                    android:textColor="@color/negro"
                    android:textSize="10sp"
                    android:textStyle="italic"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>