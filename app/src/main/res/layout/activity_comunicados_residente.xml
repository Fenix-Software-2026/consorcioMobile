<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6F8">

    <!-- Barra superior institucional con Logo y Botón de Volver -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/naranja"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/logoconsorcioappsvg"
            android:contentDescription="Logo ConsorcioMobile"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ConsorcioMobile"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVolverDashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Dashboard"
            android:textSize="12sp"
            android:textColor="@color/naranja"
            android:backgroundTint="@color/white"
            app:cornerRadius="20dp"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

    <!-- Contenedor de la lista de comunicados -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Saludo amigable genérico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Hola, Residente!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/negro"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aquí puedes consultar los avisos y comunicados oficiales del consorcio."
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginBottom="16dp" />

        <!-- Título de la Sección -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Historial de Comunicados"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/negro"
            android:layout_marginBottom="12dp"/>

        <!-- Mensaje cuando todavía no hay comunicados -->
        <TextView
            android:id="@+id/tvSinComunicados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Todavía no hay comunicados publicados."
            android:textSize="14sp"
            android:textColor="#777777"
            android:gravity="center"
            android:paddingVertical="24dp"
            android:visibility="gone" />

        <!-- Lista con los comunicados que vienen de la API -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerComunicados"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

    </LinearLayout>

</LinearLayout>
