<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6F8">

    <!-- Barra superior institucional incluida mediante layout -->
    <include
        android:id="@+id/usuariosToolbar"
        layout="@layout/barra_personalizada" />

    <!-- Contenedor de la lista de comunicados -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Saludo amigable genérico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Hola!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/negro"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aquí puedes consultar los avisos y comunicados oficiales del consorcio."
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginBottom="16dp" />

        <!-- Título de la Sección -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Historial de Comunicados"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/negro"
            android:accessibilityHeading="true"
            android:layout_marginBottom="12dp"/>

        <!-- Mensaje cuando todavía no hay comunicados -->
        <TextView
            android:id="@+id/tvSinComunicados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Todavía no hay comunicados publicados."
            android:textSize="14sp"
            android:textColor="#777777"
            android:gravity="center"
            android:paddingVertical="24dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <!-- Lista con los comunicados que vienen de la API -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerComunicados"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

    </LinearLayout>

</LinearLayout>