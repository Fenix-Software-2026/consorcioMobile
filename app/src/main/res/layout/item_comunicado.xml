<?xml version="1.0" encoding="utf-8"?>
<!--
    Tarjeta de un comunicado para la lista del residente.
    Reproduce el estilo de los ejemplos que había fijos en la vista:
    urgentes con fondo naranja, normales en blanco.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardComunicado"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tvTituloComunicado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título del comunicado"
            android:textColor="@color/negro"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- CONTENIDO (se muestra una vista previa) -->
        <TextView
            android:id="@+id/tvContenidoComunicado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contenido del comunicado..."
            android:textColor="#555555"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="8dp" />

        <!-- FECHA DE PUBLICACIÓN -->
        <TextView
            android:id="@+id/tvFechaComunicado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Publicado: --/--/----"
            android:textColor="#444444"
            android:textSize="11sp"
            android:textStyle="italic" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
