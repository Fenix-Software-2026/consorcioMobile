<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6F8">

    <!-- BARRA SUPERIOR -->
    <include
        layout="@layout/barra_personalizada"
        android:id="@+id/miToolbar"/>

    <TextView
        android:id="@+id/tvSubtituloFormulario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:text="Detalle Reclamo"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvDetalleEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_estado_proceso"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Pendiente"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalleTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Título del Reclamo"
                android:textColor="@color/negro"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalleCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Categoría: Plomería"
                android:textColor="#555555"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDetalleFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Fecha: 13/09/2026"
                android:textColor="#6C757D"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Descripción:"
                android:textColor="@color/negro"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalleDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="1dp"
                android:padding="16dp"
                android:text="Descripción completa del reclamo..."
                android:textColor="#333333"
                android:textSize="15sp" />

            <!-- Esta parte sólo la ve el admin -->
            <LinearLayout
                android:id="@+id/panelAdminEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestión de Estado (Administrador)"
                    android:textColor="@color/negro"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spCambiarEstado"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnGuardarEstadoAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Actualizar Estado"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:backgroundTint="@color/naranja" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>