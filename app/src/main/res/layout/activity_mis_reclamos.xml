<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    tools:context=".MisReclamosActivity">

    <!-- BARRA SUPERIOR INSTITUCIONAL -->
    <LinearLayout
        android:id="@+id/linearLayoutBarra"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/naranja"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/logoconsorcioappsvg"
            android:contentDescription="Logo ConsorcioMobile"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/txtTituloBarra"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mis Reclamos"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_reclamos_volver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Dashboard"
            android:textSize="12sp"
            android:textColor="@color/naranja"
            android:backgroundTint="@color/white"
            app:cornerRadius="20dp"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_crear_reclamo_activity"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="@string/crear_reclamo"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="15sp"
        android:backgroundTint="@color/naranja"
        app:cornerRadius="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutBarra"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textViewHistorial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Historial de Reclamos"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/negro"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_crear_reclamo_activity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMisReclamos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@+id/textViewHistorial"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_reclamo" />

</androidx.constraintlayout.widget.ConstraintLayout>