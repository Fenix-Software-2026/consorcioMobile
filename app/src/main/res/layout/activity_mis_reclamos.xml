<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    tools:context=".MisReclamosActivity">

    <!-- BARRA SUPERIOR INSTITUCIONAL INCLUIDA -->
    <include
        android:id="@+id/usuariosToolbar"
        layout="@layout/barra_personalizada"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_crear_reclamo_activity"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="@string/crear_reclamo"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="15sp"
        android:backgroundTint="@color/naranja"
        app:cornerRadius="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@+id/usuariosToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textViewHistorial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Historial de Reclamos"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/negro"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_crear_reclamo_activity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMisReclamos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@+id/textViewHistorial"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_reclamo" />

</androidx.constraintlayout.widget.ConstraintLayout>