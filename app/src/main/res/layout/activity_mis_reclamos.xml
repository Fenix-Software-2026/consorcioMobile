<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6F8"
    tools:context=".MisReclamosActivity">

    <!-- BARRA SUPERIOR INSTITUCIONAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/naranja"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/logoconsorcioappsvg"
            android:contentDescription="Logo ConsorcioMobile"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/txtTituloBarra"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mis Reclamos"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_reclamos_volver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Dashboard"
            android:textSize="12sp"
            android:textColor="@color/naranja"
            android:backgroundTint="@color/white"
            app:cornerRadius="20dp"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

    <!-- CONTENEDOR CON SCROLL PARA EL CONTENIDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- BOTÓN DE ACCIÓN SUPERIOR: CREAR RECLAMO -->
            <Button
                android:id="@+id/btn_crear_reclamo_activity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/crear_reclamo"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:backgroundTint="@color/naranja"
                app:cornerRadius="12dp"
                android:layout_marginBottom="20dp"
                android:elevation="2dp" />

            <!-- TÍTULO DE LA SECCIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Historial de Reclamos"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/negro"
                android:layout_marginBottom="12dp" />

            <!-- TARJETA DE EJEMPLO (MOLDE DE RECLAMO) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/blanco"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/naranja"
                app:strokeWidth="1.5dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- TÍTULO DEL RECLAMO -->
                    <TextView
                        android:id="@+id/tvTituloReclamo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/reparaci_n_de_ascensor"
                        android:textColor="@color/negro"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- CATEGORÍA CON ICONO -->
                    <ImageView
                        android:id="@+id/ivIconoCategoria"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="10dp"
                        android:src="@drawable/baseline_build_24"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTituloReclamo"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tvCategoriaReclamo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/mantenimiento"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivIconoCategoria"
                        app:layout_constraintStart_toEndOf="@id/ivIconoCategoria"
                        app:layout_constraintTop_toTopOf="@id/ivIconoCategoria" />

                    <!-- ESTADO (ETIQUETA TIPO CHIP) -->
                    <TextView
                        android:id="@+id/tvEstadoReclamo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_estado_proceso"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/en_proceso"
                        android:textColor="@color/verde_texto"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivIconoCategoria"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/ivIconoCategoria" />

                    <!-- DESCRIPCIÓN -->
                    <TextView
                        android:id="@+id/tvDescripcionReclamo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@color/naranja_suave"
                        android:padding="12dp"
                        android:text="El ascensor hace ruidos extraños..."
                        android:textColor="@color/negro"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivIconoCategoria" />

                    <!-- UBICACIÓN -->
                    <ImageView
                        android:id="@+id/ivIconoUbicacion"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="12dp"
                        android:src="@drawable/baseline_place_24"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvDescripcionReclamo"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tvUbicacionReclamo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Edificio Principal"
                        android:textColor="#6C757D"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@id/ivIconoUbicacion"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivIconoUbicacion"
                        app:layout_constraintTop_toTopOf="@id/ivIconoUbicacion" />

                    <!-- FECHA -->
                    <ImageView
                        android:id="@+id/ivIconoCalendario"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivIconoUbicacion"
                        app:srcCompat="@drawable/baseline_event_24"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tvFechaReclamo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Creado el 13 de sep, 2026"
                        android:textColor="#6C757D"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@id/ivIconoCalendario"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivIconoCalendario"
                        app:layout_constraintTop_toTopOf="@id/ivIconoCalendario" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>