<?xml version="1.0" encoding="utf-8"?>
    <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/blanco"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/naranja"
        app:strokeWidth="1.5dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- TÍTULO DEL RECLAMO -->
            <TextView
                android:id="@+id/tvTituloReclamo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Título del reclamo"
                android:textColor="@color/negro"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- CATEGORÍA CON ICONO -->
            <ImageView
                android:id="@+id/ivIconoCategoria"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/baseline_build_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTituloReclamo"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvCategoriaReclamo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Categoría"
                android:textColor="#555555"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/ivIconoCategoria"
                app:layout_constraintStart_toEndOf="@id/ivIconoCategoria"
                app:layout_constraintTop_toTopOf="@id/ivIconoCategoria" />

            <!-- ESTADO (ETIQUETA TIPO CHIP) -->
            <TextView
                android:id="@+id/tvEstadoReclamo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_estado_proceso"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="En Proceso"
                android:textColor="@color/verde_texto"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/ivIconoCategoria"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivIconoCategoria" />

            <!-- DESCRIPCIÓN -->
            <TextView
                android:id="@+id/tvDescripcionReclamo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/naranja_suave"
                android:padding="12dp"
                android:text="Descripción del reclamo..."
                android:textColor="@color/negro"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivIconoCategoria" />

            <!-- UBICACIÓN -->
            <ImageView
                android:id="@+id/ivIconoUbicacion"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/baseline_place_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDescripcionReclamo"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvUbicacionReclamo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Ubicación"
                android:textColor="#6C757D"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/ivIconoUbicacion"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivIconoUbicacion"
                app:layout_constraintTop_toTopOf="@id/ivIconoUbicacion" />

            <!-- FECHA -->
            <ImageView
                android:id="@+id/ivIconoCalendario"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivIconoUbicacion"
                app:srcCompat="@drawable/baseline_event_24"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvFechaReclamo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Fecha"
                android:textColor="#6C757D"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/ivIconoCalendario"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivIconoCalendario"
                app:layout_constraintTop_toTopOf="@id/ivIconoCalendario" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

